<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Connexion — MiniEvent</title>

    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

<header>
    <a href="/events">
        <img src="/images/Mic-Event.png" class="header-logo">
    </a>

    <div class="nav-links">
        <a href="/events">Événements</a>

        <a href="/reservations/my" id="nav-reservations" class="hidden">
            Mes réservations
        </a>

        <span id="nav-user" class="hidden"></span>

        <button id="btn-logout" class="hidden" onclick="logout()">
            Déconnexion
        </button>

        <a href="/login" id="btn-login">
            Connexion
        </a>
    </div>
</header>

<main>
    <div class="screen">
        <img src="/images/Mic-Event.png" alt="Logo" class="logo">
        <h2>Bienvenue sur MiniEvent</h2>

        <div class="auth-box">

            <div class="form-group">
                <label for="auth-email">📧 Adresse e-mail</label>
                <input type="email" id="auth-email" placeholder="vous@exemple.com" autocomplete="email">
            </div>

            <div class="form-group" id="name-group">
                <label for="auth-name">
                    👤 Nom affiché
                    <span style="font-weight:400;opacity:.7">(inscription uniquement)</span>
                </label>
                <input type="text" id="auth-name" placeholder="Prénom Nom" autocomplete="name">
            </div>

            <div id="passkey-supported">
                <button id="btn-register" class="btn-full btn-primary">
                    S'inscrire avec Passkey
                </button>
                <div class="separator">ou</div>
                <button id="btn-login-passkey" class="btn-full btn-outline-dark">
                    Se connecter avec Passkey
                </button>
            </div>

            <div id="passkey-unsupported" class="hidden">
                <div class="alert-warning">
                    <p>⚠️ Navigateur non compatible Passkeys.</p>
                </div>
            </div>

            <div id="auth-message" class="message hidden"></div>

        </div>
    </div>
</main>

<script>
    function getToken() {
        return localStorage.getItem('jwt_token');
    }

    function removeToken() {
        localStorage.removeItem('jwt_token');
        localStorage.removeItem('refresh_token');
    }

    function updateNavbar(user) {
        const navReservations = document.getElementById('nav-reservations');
        const btnLogout = document.getElementById('btn-logout');
        const btnLogin = document.getElementById('btn-login');
        const navUser = document.getElementById('nav-user');

        if (user) {
            navReservations.classList.remove('hidden');
            btnLogout.classList.remove('hidden');
            btnLogin.classList.add('hidden');

            navUser.textContent = user.displayName || user.email;
            navUser.classList.remove('hidden');
        } else {
            navReservations.classList.add('hidden');
            btnLogout.classList.add('hidden');
            btnLogin.classList.remove('hidden');
            navUser.classList.add('hidden');
        }
    }

    async function fetchUserInfo() {
        const token = getToken();

        if (!token) {
            updateNavbar(null);
            return;
        }

        try {
            const res = await fetch('/api/auth/me', {
                headers: { 'Authorization': 'Bearer ' + token }
            });

            if (!res.ok) {
                removeToken();
                updateNavbar(null);
                return;
            }

            const user = await res.json();
            updateNavbar(user);

        } catch (e) {
            updateNavbar(null);
        }
    }

    async function logout() {
        const refresh = localStorage.getItem('refresh_token');

        if (refresh) {
            await fetch('/api/auth/logout', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ refresh_token: refresh })
            });
        }

        removeToken();
        updateNavbar(null);
        window.location.href = "/events";
    }

    document.addEventListener('DOMContentLoaded', fetchUserInfo);
</script>

<script src="/js/api.js"></script>
<script src="/js/auth.js"></script>

<script>
    const EVENTS_URL = '/events';

    function showMessage(type, text) {
        const el = document.getElementById('auth-message');
        el.className = 'message ' + type;
        el.textContent = text;
        el.classList.remove('hidden');
        setTimeout(() => el.classList.add('hidden'), 5000);
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (!Auth.isPasskeySupported()) {
            document.getElementById('passkey-supported').classList.add('hidden');
            document.getElementById('passkey-unsupported').classList.remove('hidden');
            return;
        }

        /* ---------- REGISTER ---------- */
        document.getElementById('btn-register').onclick = async () => {
            const email = document.getElementById("auth-email").value.trim();
            const name = document.getElementById("auth-name").value.trim() || email;

            if (!email) return showMessage('error', 'Email requis.');

            try {
                const user = await Auth.register(email, name);
                showMessage('success', 'Bienvenue ' + user.displayName);
                setTimeout(() => window.location.href = EVENTS_URL, 1200);

            } catch (err) {
                showMessage('error', err.message);
            }
        };

        /* ---------- LOGIN ---------- */
        document.getElementById('btn-login-passkey').onclick = async () => {
            const email = document.getElementById("auth-email").value.trim();

            if (!email) return showMessage('error', 'Email requis.');

            try {
                const user = await Auth.loginWithPasskey(email);
                showMessage('success', 'Bonjour ' + user.displayName);
                setTimeout(() => window.location.href = EVENTS_URL, 1200);

            } catch (err) {
                showMessage('error', err.message);
            }
        };
    });
</script>

</body>
</html>
