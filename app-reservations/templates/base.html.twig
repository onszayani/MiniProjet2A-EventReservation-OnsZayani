<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MiniEvent{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <link rel="stylesheet" href="{{ asset('css/header.css') }}">
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    <link rel="stylesheet" href="{{ asset('css/footer.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>

{# ── HEADER / NAVBAR ── #}
<header>
    <a href="{{ path('app_events') }}">
        <img src="{{ asset('images/Mic-Event.png') }}" alt="MicEvent Logo" class="header-logo">
    </a>
    <div class="nav-links">
        <a href="{{ path('app_events') }}"
           class="{% if app.request.attributes.get('_route') == 'app_events' %}active{% endif %}">
            Événements
        </a>
        <a href="{{ path('reservations_my') }}"
           id="nav-reservations"
           class="hidden">
            Mes réservations
        </a>
        <span id="nav-user" class="nav-user hidden"></span>
        <button id="btn-logout"
                class="btn btn-outline hidden"
                onclick="logout()">
            Déconnexion
        </button>
        <a href="{{ path('auth_login') }}"
           class="login-btn"
           id="btn-login">
            Connexion
        </a>
    </div>
</header>

{# ── CONTENU DE LA PAGE ── #}
<main>
    {% block body %}{% endblock %}
</main>


